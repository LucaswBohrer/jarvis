# JARVIS Phase 1 — example environment. Copy to .env (never commit a real .env).
# Local-only: JARVIS_HOST must stay a loopback address. Default port 8123
# (8100 collides with the nexus-deploy proxy on this machine).

JARVIS_ENV=local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8123
JARVIS_DATABASE_URL=sqlite+aiosqlite:///./data/jarvis.db
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_FORMAT=json
JARVIS_DEFAULT_LOCALE=pt-BR
JARVIS_POLICY_FILE=./config/policy.toml

# NEXUS integration (read-only, loopback only)
JARVIS_NEXUS_BASE_URL=http://127.0.0.1:8000
JARVIS_NEXUS_EQUIPMENT_CODE=DEFAULT
JARVIS_NEXUS_CONNECT_TIMEOUT_MS=400
JARVIS_NEXUS_READ_TIMEOUT_MS=1200
JARVIS_NEXUS_POOL_TIMEOUT_MS=400
JARVIS_NEXUS_TOTAL_DEADLINE_MS=3500
JARVIS_NEXUS_MAX_RETRIES=1
JARVIS_NEXUS_CIRCUIT_FAILURE_THRESHOLD=3
JARVIS_NEXUS_CIRCUIT_RESET_SECONDS=15
JARVIS_NEXUS_MAX_RESPONSE_BYTES=262144
JARVIS_NEXUS_FRESHNESS_SECONDS=10

# LLM provider: "fake" (deterministic, tests/dev) or "openai" (REST via httpx).
JARVIS_LLM_PROVIDER=fake
JARVIS_LLM_MODEL=
JARVIS_LLM_TIMEOUT_SECONDS=15
JARVIS_LLM_MAX_OUTPUT_TOKENS=300
JARVIS_OPENAI_API_KEY=
JARVIS_LLM_INPUT_PRICE_PER_1M_USD=
JARVIS_LLM_OUTPUT_PRICE_PER_1M_USD=

# Context budgets in chars (Phase 2, Slice 2). No token counting.
JARVIS_CTX_TOTAL_CHARS=12000
JARVIS_CTX_TAIL_CHARS=4000
JARVIS_CTX_PREFERENCES_CHARS=2000
JARVIS_CTX_MEMORIES_CHARS=4000
JARVIS_CTX_FACTS_CHARS=8000
